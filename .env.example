# FarmTrace API Environment Variables
# For Supabase migration, you only need these:

# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # Only for server-side functions, if needed

# Mapbox (keep from current config)
MAPBOX_TOKEN=

# File Storage (if using Supabase Storage instead of R2/S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# n8n Webhook URL (if used)
N8N_WEBHOOK_URL=
